# No user-supplied environment variables or secrets are required for the first
# Cloudflare Pages deploy. .node-version selects Node 24. Pages automatically
# supplies CF_PAGES=1 and CF_PAGES_URL for host disclosure and initial URLs.

# Recommended after the first deployment: set this to the ACTUAL stable project
# URL returned by Pages, then redeploy. CF_PAGES_URL is deployment-specific.
# NEXT_PUBLIC_SITE_URL=https://your-actual-project.pages.dev

# Optional explicit overrides (automatic Pages detection also works):
# NEXT_PUBLIC_HOSTING_PROVIDER=cloudflare
# NEXT_PUBLIC_CONTACT_EMAIL=your-domain-email@example.com

# Optional Cloudflare build-runtime override; .node-version already selects 24.
# NODE_VERSION=24

# Neon remains for later enquiry storage. No DATABASE_URL, Retell key, email key,
# Calendly credential or Cloudflare API token is needed by the marketing site.
# Keep future server secrets private and never prefix them NEXT_PUBLIC_.
