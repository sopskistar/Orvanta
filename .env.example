# No secrets or user-supplied variables are required. .node-version selects Node 24.
# Local exports and Cloudflare builds default to the same production origin.

# Optional override; remove old dashboard/local values or set this exact origin.
# NEXT_PUBLIC_SITE_URL=https://getorvanta.xyz
# CF_PAGES_URL and legacy Vercel hostnames never select canonical URLs.

# Optional explicit overrides (Cloudflare is the default host):
# NEXT_PUBLIC_HOSTING_PROVIDER=cloudflare
# NEXT_PUBLIC_CONTACT_EMAIL=your-domain-email@example.com

# Optional Cloudflare build-runtime override; .node-version already selects 24.
# NODE_VERSION=24

# Neon remains for later enquiry storage. No DATABASE_URL, Retell key, email key,
# Calendly credential or Cloudflare API token is needed by the marketing site.
# Keep future server secrets private and never prefix them NEXT_PUBLIC_.
