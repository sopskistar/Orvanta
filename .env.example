# No secrets or database environment variables are required for the launch site.
# Vercel supplies VERCEL_PROJECT_PRODUCTION_URL automatically (enable System
# Environment Variables in project settings). The code uses it for public URLs.

# Optional override after you know your real production HTTPS URL.
# NEXT_PUBLIC_SITE_URL=https://your-actual-project.vercel.app

# Recommended public hosting disclosure for the intended deployment:
NEXT_PUBLIC_HOSTING_PROVIDER=vercel

# Optional public email override; the supplied Gmail address works by default.
# NEXT_PUBLIC_CONTACT_EMAIL=your-domain-email@example.com

# Neon is intended for later enquiry storage. Do not create a database or set
# DATABASE_URL merely to launch this marketing site. Later connection strings,
# Retell keys and email-provider keys must be server-only, never NEXT_PUBLIC_*.
