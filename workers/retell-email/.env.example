# Copy to .env.local for private Node setup/operations scripts.
# For Wrangler local runtime, copy the same values to .dev.vars.
# Both files are ignored. Never prefix these values with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DB?sslmode=require
RETELL_API_KEY=replace-with-the-webhook-badged-key-from-your-workspace
RETELL_WORKSPACE_ID=replace-with-your-workspace-id
AGENT_ROUTES_JSON='{"agent_REPLACE":{"clientId":"orvanta","workspaceId":"replace-with-your-workspace-id","recipient":"julianahonour@gmail.com"}}'
RESEND_API_KEY=replace-with-your-resend-key
# Optional local-only read/setup key if RESEND_API_KEY is restricted to sending.
# RESEND_SETUP_API_KEY=replace-with-a-private-read-capable-resend-key
# Use this only after the exact sender subdomain is verified in Resend.
EMAIL_FROM=enquiries@notify.getorvanta.xyz
# Generate locally: openssl rand -hex 32
PROCESSING_TOKEN=replace-with-a-random-private-64-character-token
# Enable explicitly after migrations, routing and sender checks pass.
DELIVERY_ENABLED=false
# Set the actual returned workers.dev origin after deployment; no Pages route.
WORKER_URL=https://replace-with-the-returned-worker-host.workers.dev
# Optional isolated Neon TEST branch for the SQL/concurrency suite, never production.
# WORKFLOW_TEST_DATABASE_URL=postgresql://...
# ALLOW_WORKFLOW_TEST_RESET=true
