{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orvanta-retell-email",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": false },
  "vars": { "DELIVERY_ENABLED": "false", "BOOKING_ENABLED": "false" }
}
